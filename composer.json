{
    "name": "pentarix/wordpress-database",
    "description": "WordPress query argument builders with a fluent, Composer-autoloadable API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pentarix\\WordPressDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pentarix\\WordPressDatabase\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
